;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wait-a-sec-"
config/description="A game for the GMTK Game Jam, it's about countdowns..."
config/version="0.8.1"
run/main_scene="uid://j1clhx71jkui"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://dt87wrmmuylxb"

[audio]

buses/default_bus_layout=""

[autoload]

ScrGlobal="*uid://d27diadk6d0hu"

[display]

window/size/viewport_width=153
window/size/viewport_height=153
window/size/window_width_override=1836
window/size/window_height_override=1836
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

